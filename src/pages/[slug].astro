---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';

// Slugs served by dedicated routes or intentionally dropped.
export async function getStaticPaths() {
  const RESERVED = new Set(['home', 'wandering-husky', 'blog', 'blog-feed']);
  const pages = await getCollection('pages');
  return pages
    .filter((p) => p.data.type !== 'portfolio' && !RESERVED.has(p.data.slug))
    .map((page) => ({ params: { slug: page.data.slug }, props: { page } }));
}

const { page } = Astro.props;
const { Content } = await render(page);
---
<Base title={page.data.title}>
  <div class="wrap">
    <article class="prose">
      <h1>{page.data.title}</h1>
      <Content />
    </article>
  </div>
</Base>
