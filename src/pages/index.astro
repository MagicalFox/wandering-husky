---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import settings from '../data/settings.json';

const pages = await getCollection('pages');
const posts = (await getCollection('posts')).sort((a, b) => b.data.date.localeCompare(a.data.date));

const home = pages.find((p) => p.data.slug === 'home' || p.data.title === 'Wandering Husky');
const { Content } = home ? await render(home) : { Content: null };

const journeys = pages
  .filter((p) => /life-on-the-road/.test(p.data.slug) || ['alaska', 'alaska-bear-story', 'california'].includes(p.data.slug))
  .sort((a, b) => b.data.date.localeCompare(a.data.date));

function shortTitle(t: string) {
  return t.replace(/^(\d{4}),?\s*Life On The Road\s*/i, '').replace(/\s+/g, ' ').trim();
}

const latestJourneys = journeys.slice(0, 6);
const latestPosts = posts.slice(0, 3);
const shenma = pages.find((p) => p.data.slug === 'shenma-the-husky');
---
<Base title="Wandering Husky" description="A travel journal and photo archive — years of life on the road.">
  {settings.heroImage && (
    <section class="hero">
      <img src={settings.heroImage} alt="" loading="eager" />
      <div class="hero-text">
        <blockquote>“{settings.heroQuote}”</blockquote>
        <p class="hero-sub">{settings.heroSub}</p>
      </div>
    </section>
  )}

  <div class="wrap">
    <section class="intro">
      <p class="intro-text">{settings.introText}</p>
    </section>

    <section>
      <div class="section-head">
        <h2 class="section-title">Latest Journeys</h2>
        <a class="more-link" href="/trips/">All journeys →</a>
      </div>
      <div class="grid">
        {latestJourneys.map((j) => (
          <a class="card" href={`/${j.data.slug}/`}>
            {j.data.hero && <img src={j.data.hero} alt="" loading="lazy" />}
            <h2>{shortTitle(j.data.title)}</h2>
            <div class="date">{j.data.slug.match(/^20\d\d/)?.[0] ?? j.data.date.slice(0, 4)}</div>
          </a>
        ))}
      </div>
    </section>

    {shenma && (
      <section class="teaser">
        <div class="teaser-img">
          {shenma.data.hero && <img src={shenma.data.hero} alt="Shenma the husky" loading="lazy" />}
        </div>
        <div class="teaser-text">
          <h2 class="section-title">Meet Shenma</h2>
          <p>{settings.shenmaTeaser}</p>
          <a class="more-link" href="/shenma-the-husky/">Her story →</a>
        </div>
      </section>
    )}

    <section>
      <div class="section-head">
        <h2 class="section-title">From the Blog</h2>
        <a class="more-link" href="/blog/">All posts →</a>
      </div>
      <div class="grid">
        {latestPosts.map((p) => (
          <a class="card" href={`/blog/${p.data.slug}/`}>
            {p.data.hero && <img src={p.data.hero} alt="" loading="lazy" />}
            <h2>{p.data.title}</h2>
            <div class="date">{p.data.date}</div>
          </a>
        ))}
      </div>
    </section>

    <div class="prose home-content">
      {Content && <Content />}
    </div>
  </div>
</Base>
